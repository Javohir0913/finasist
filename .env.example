# Скопируйте в .env и подставьте свои значения. Файл .env в git НЕ попадает.
#
# Сгенерировать надёжные значения:
#   openssl rand -base64 32        (SECRET_KEY)
#   openssl rand -base64 18        (пароли)

# --- База данных ---
POSTGRES_USER=finasist
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=finasist

# --- Подпись JWT. При смене все выданные токены становятся недействительными ---
SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_32_БАЙТА

# --- Супер-админ. Создаётся ОДИН раз, при первом старте на пустой базе ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ
SUPERADMIN_NAME=Super Admin

# --- Только для сервера (docker-compose.prod.yml) ---
# Порт на 127.0.0.1, к которому обращается системный nginx.
# Проверьте, что он не занят: ss -tlnp | grep <порт>
WEB_PORT=5181
